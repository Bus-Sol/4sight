<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_lead_notification_state_company_rule" model="ir.rule">
        <field name="name">CRM notification states: allowed companies</field>
        <field name="model_id" ref="model_crm_lead_notification_state"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="crm_lead_notification_state_own_rule" model="ir.rule">
        <field name="name">CRM notification states: own state only</field>
        <field name="model_id" ref="model_crm_lead_notification_state"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
</odoo>
