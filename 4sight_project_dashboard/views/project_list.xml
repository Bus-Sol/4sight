<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="project_project_list_view" model="ir.ui.view">
            <field name="name">Project List View</field>
            <field name="model">project.project</field>
            <field name="priority" eval="20"/>
            <field name="arch" type="xml">
                <tree string="Projects" editable="bottom" create="false" default_order="partner_id, name">
                    <field name="partner_id" optional="show" string="Customer" widget="res_partner_many2one"/>
                    <field name="display_name" string="Name" class="fw-bold"/>
                    <button string="View" name="action_open_project" type="object"/>

                    <field name="name" string="Name" column_invisible="1"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide"/>
                    <field name="user_id" optional="show" string="Project Manager" widget="many2one_avatar_user" options="{'no_open':True, 'no_create': True, 'no_create_edit': True}"/>
                    <field name="company_id" optional="hide" groups="base.group_multi_company" options="{'no_create': True, 'no_open': True}"/>
                    <field name="company_id" column_invisible="True"/>
                    <field name="date_start" string="Planned Date" widget="daterange" options="{'end_date_field': 'date', 'always_range': '1'}" optional="hide"/>
                    <field name="stage_id" options="{'no_open': True}" domain="[('company_id', 'in', (company_id, False))]" optional="show"/>
                    <field name="allocated_hours" widget="float_time" sum="Total"/>
                    <field name="tasks_allocated_hours" widget="float_time" column_invisible="1" sum="Total"/>
                    <field name="paid_hours" widget="float_time" groups="account.group_account_manager" sum="Total"/>
                    <field name="paid_hours" widget="float_time" readonly="1" groups="!account.group_account_manager" sum="Total"/>
                    <field name="effective_hours" widget="float_time" sum="Total"/>
                    <field name="tasks_remaining_hours"  widget="float_time" decoration-danger="progress &gt;= 100" decoration-warning="progress &gt;= 80 and progress &lt; 100" groups="hr_timesheet.group_hr_timesheet_user" column_invisible="1" sum="Total"/>
                    <field name="project_remaining_hours"  widget="float_time" decoration-danger="progress &gt;= 100" decoration-warning="progress &gt;= 80 and progress &lt; 100" groups="hr_timesheet.group_hr_timesheet_user" sum="Total"/>
                    <field name="remaining_from_paid" widget="float_time" decoration-danger="paid_progress &gt;= 100" decoration-warning="paid_progress &gt;= 80 and paid_progress &lt; 100" sum="Total" groups="hr_timesheet.group_hr_timesheet_user"/>
                    <field name="paid_progress" string="Paid Progress" widget="progressbar"  options="{'overflow_class': 'bg-danger'}" groups="hr_timesheet.group_hr_timesheet_user"/>
                    <field name="progress" string="Project Progress" widget="project_task_progressbar" options="{'overflow_class': 'bg-danger'}" groups="hr_timesheet.group_hr_timesheet_user"/>
                    <field name="sale_order_id"/>
                    <field name="invoice_ids" widget="many2many_tags" groups="account.group_account_manager"/>
                    <field name="invoice_total" groups="account.group_account_manager" sum="Total"/>
                    <field name="invoice_due" groups="account.group_account_manager" sum="Total"/>

                    <field name="achievements"/>
                    <field name="next_deliverables"/>
                    <field name="dependencies"/>
                    <field name="action_items"/>

                    <button string="View Tasks" name="action_view_tasks" type="object"/>
                </tree>
            </field>
        </record>

        <record id="project_project_action_view" model="ir.actions.act_window">
            <field name="name">Projects</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.project</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="project_project_list_view"/>
            <field name="search_view_id" ref="project.view_project_project_filter"/>
        </record>

        <menuitem name="Projects List" id="menu_project_analysis_list"
                  sequence="20"
                  parent="project.menu_project_management"
                  action="project_project_action_view"/>


        <!-- Inherit Form View to Modify it -->
        <record id="project_form_inherit" model="ir.ui.view">
            <field name="name">project.project.form.inherit</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">

                <xpath expr="//notebook" position="inside">
                    <page string="Notes" name="notes">
                        <group>
                            <group string="Achievements">
                                <field name="achievements" nolabel="1" colspan="2"/>

                            </group>
                            <group string="Issues/Risks/Dependencies">
                                <field name="dependencies" nolabel="1" colspan="2"/>

                            </group>
                        </group>
                        <group>
                            <group string="Next Deliverables">
                                <field name="next_deliverables" nolabel="1" colspan="2"/>

                            </group>
                            <group string="Action Items">
                                <field name="action_items" nolabel="1" colspan="2"/>

                            </group>
                        </group>

                    </page>
                </xpath>

            </field>
        </record>


    </data>
</odoo>