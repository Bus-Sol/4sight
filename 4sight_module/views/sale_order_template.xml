<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="sale_order_template_view_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.template.form.inherit</field>
            <field name="model">sale.order.template</field>
            <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
            <field name="arch" type="xml">

                    <group name="sale_info" position="after">
                        <group>
                            <field name="is_flow_template"/>
                            <field name="flow_image" widget="image" invisible="not is_flow_template"/>
                            <field name="flow_details" invisible="not is_flow_template"/>
                        </group>
                    </group>

            </field>
        </record>



    </data>
</odoo>