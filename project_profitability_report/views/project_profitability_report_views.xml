<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_profitability_report_tree" model="ir.ui.view">
        <field name="name">project.profitability.report.tree</field>
        <field name="model">project.profitability.report</field>
        <field name="arch" type="xml">
            <tree string="Project Profitability" create="0" edit="0" delete="0" decoration-danger="margin &lt; 0" decoration-success="margin &gt; 0">
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="user_id" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="sale_amount" sum="Total Sales"/>
                <field name="invoiced_revenue" sum="Total Invoiced"/>
                <field name="purchase_commitment" sum="Total Commitments" optional="show"/>
                <field name="vendor_bill_cost" sum="Total Vendor Bills"/>
                <field name="timesheet_cost" sum="Total Timesheets"/>
                <field name="expense_cost" sum="Total Expenses" optional="show"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="margin" sum="Total Margin"/>
                <field name="margin_percent" widget="percentage"/>
                <button name="action_open_project" type="object" icon="fa-folder-open" title="Open Project"/>
                <button name="action_open_sales_order" type="object" icon="fa-shopping-cart" title="Open Sales Order" invisible="not sale_order_id"/>
                <button name="action_open_analytic_items" type="object" icon="fa-list" title="Open Analytic Items"/>
            </tree>
        </field>
    </record>

    <record id="view_project_profitability_report_search" model="ir.ui.view">
        <field name="name">project.profitability.report.search</field>
        <field name="model">project.profitability.report</field>
        <field name="arch" type="xml">
            <search string="Project Profitability">
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="sale_order_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="loss_projects" string="Loss Projects" domain="[('margin', '&lt;', 0)]"/>
                <filter name="profitable_projects" string="Profitable Projects" domain="[('margin', '&gt;', 0)]"/>
                <separator/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_manager" string="Project Manager" context="{'group_by': 'user_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="view_project_profitability_report_pivot" model="ir.ui.view">
        <field name="name">project.profitability.report.pivot</field>
        <field name="model">project.profitability.report</field>
        <field name="arch" type="xml">
            <pivot string="Project Profitability">
                <field name="project_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="sale_amount" type="measure"/>
                <field name="invoiced_revenue" type="measure"/>
                <field name="total_cost" type="measure"/>
                <field name="margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_project_profitability_report_graph" model="ir.ui.view">
        <field name="name">project.profitability.report.graph</field>
        <field name="model">project.profitability.report</field>
        <field name="arch" type="xml">
            <graph string="Project Profitability" type="bar">
                <field name="project_id"/>
                <field name="invoiced_revenue" type="measure"/>
                <field name="total_cost" type="measure"/>
                <field name="margin" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_project_profitability_report" model="ir.actions.act_window">
        <field name="name">Project Profitability</field>
        <field name="res_model">project.profitability.report</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="search_view_id" ref="view_project_profitability_report_search"/>
        <field name="context">{'search_default_group_project': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No project profitability data found.</p>
            <p>Projects must have an analytic account. Sales, invoices, bills, purchases, expenses and timesheets should use that analytic account.</p>
        </field>
    </record>

    <menuitem id="menu_project_profitability_report"
              name="Project Profitability"
              parent="account.menu_finance_reports"
              action="action_project_profitability_report"
              sequence="95"
              groups="account.group_account_user"/>
</odoo>
