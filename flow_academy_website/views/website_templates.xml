                }

                .slider-arrow {
                    background: rgba(0,0,0,0.4);
                    border: none;
                    color: white;
                    font-size: 25px;
                    padding: 10px 15px;
                    cursor: pointer;
                    border-radius: 50%;
                }

                /* Tablet logo slider */
                @media (max-width: 768px) {
