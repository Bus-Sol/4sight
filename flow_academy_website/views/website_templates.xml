                    }
                }

                /* Mobile logo slider */
                @media (max-width: 576px) {
                    .slider-item img {
                        width: 70px;
                        height: 70px;
                    }

                    .slider-track {
                        gap: 25px;
                    }

                    .slider-arrow {
                        font-size: 18px;
