                    -webkit-overflow-scrolling: touch;
                    padding-bottom: 15px;

                    /* Hide Scrollbar for all browsers */
                    scrollbar-width: none; /* Firefox */
                    -ms-overflow-style: none; /* IE/Edge */
                    }

                    .event-slider-wrapper::-webkit-scrollbar {
                    display: none; /* Chrome, Safari, Opera */
                    }

