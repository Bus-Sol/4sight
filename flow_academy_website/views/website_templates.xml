                /* Optional: Hide buttons on very small screens */
                @media (max-width: 480px) {
                    .slider-nav-btn {
                        opacity: 0.7;
                    }
                }

                /* 4. Card Item Sizing */
                .event-card-item {
                    flex: 0 0 auto;
                    box-sizing: border-box;
                    scroll-snap-align: start;
                }

                /* Override any custom CSS that removes column padding */
                .event-card-item.col-9,
                .event-card-item.col-sm-9,
                .event-card-item.col-md-6,
                .event-card-item.col-lg-4 {
                    padding-left: 0 !important;
                    padding-right: 0 !important;
                }

                /* Desktop sizing */
                @media (min-width: 992px) {
                    .event-card-item {
                        width: calc(33.333% - 14px) !important;  /* subtract gap */
                        flex: 0 0 calc(33.333% - 14px) !important;
                    }
                }

                /* Tablet sizing */
                @media (min-width: 768px) and (max-width: 991px) {
                    .event-card-item {
                        width: 50%; /* col-md-6 */
                        flex: 0 0 50% !important;
                    }
                }

                /* Small tablet */
                @media (min-width: 576px) and (max-width: 767px) {
                    .event-card-item {
                        width: calc(100vw - 80px) !important;
                        max-width: calc(100vw - 80px) !important;
                        flex: 0 0 calc(100vw - 80px) !important;
                    }
                }

                /* Mobile sizing */
                @media (max-width: 575px) {
                    .event-card-item {
                        width: calc(100vw - 60px) !important;  /* full width minus nav buttons + padding */
                        max-width: calc(100vw - 60px) !important;
                        flex: 0 0 calc(100vw - 60px) !important;
                    }
                }



                /* Important: Ensure internal card content doesn't break layout */
                .event-card-item .card-body .col {
                    padding: 0 !important; /* Keep your original style for internal cols */
                }

                /* 5. Mobile Card Spacing */
                @media (max-width: 576px) {
                    .event-slider-wrapper .row {
                        gap: 5px;
                    }
                }

                /* ========================================
                   RESPONSIVE LOGO SLIDER STYLES
                   ======================================== */

                .slider-wrapper {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 15px;
                    width: 100%;
                }

                .slider-container {
                    width: 100%;
                    overflow: hidden;
                    padding: 20px 0;
                }

                .slider-track {
                    display: flex;
                    gap: 60px;
                    transition: transform 0.5s ease;
                }

                .slider-item img {
                    width: 120px;
                    height: 120px;
                    object-fit: contain;
                    filter: grayscale(100%);
                    transition: filter 0.4s ease-in-out;
                }

                .slider-item img:hover {
