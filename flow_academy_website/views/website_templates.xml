<odoo>

    <template id="dynamic_logo_template" inherit_id="website.option_header_brand_logo">
        <xpath expr="//a" position="replace">
    <a data-name="Navbar Logo" href="/" t-attf-class="navbar-brand logo #{_link_class}" id="header_link">
        <!-- Add class for easier selection -->
        <img id="header_logo" class="dynamic-logo" src="/flow_academy_website/static/src/image/4sight_logo.jpg" alt="Logo" style="height: 40px;"/>
    </a>

    <script>
        (function() {
            // Function to get cookie value
            function getCookie(name) {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) return parts.pop().split(';').shift();
            }

            // Update ALL logo instances across the entire page
            function updateAllLogos() {
                var logoPreference = getCookie('logo_preference');

                // Determine logo and link based on preference
                var logoSrc = '/flow_academy_website/static/src/image/4sight_logo.jpg';
                var linkHref = '/';

                if (logoPreference === 'flow_logo') {
                    logoSrc = '/flow_academy_website/static/src/image/flow_logo.jpg';
                    linkHref = 'https://www.flowacademy.mt/';
                }

                // Strategy 1: Update by specific IDs
                var headerLogo = document.getElementById('header_logo');
                if (headerLogo) {
                    headerLogo.src = logoSrc;
                }

                var headerLink = document.getElementById('header_link');
                if (headerLink) {
                    headerLink.href = linkHref;
                }

                // Strategy 2: Update ALL images with alt="Logo" (catches duplicates)
                var allLogoImages = document.querySelectorAll('img[alt="Logo"]');
                allLogoImages.forEach(function(img) {
                    img.src = logoSrc;
                });

                // Strategy 3: Update by class
                var dynamicLogos = document.querySelectorAll('.dynamic-logo');
                dynamicLogos.forEach(function(img) {
                    img.src = logoSrc;
                });

                // Strategy 4: Update all navbar-brand links
                var navbarLinks = document.querySelectorAll('.navbar-brand');
                navbarLinks.forEach(function(link) {
                    link.href = linkHref;
                });

                // Strategy 5: Target offcanvas/mobile menu (Odoo's mobile navbar)
                var offcanvasLogos = document.querySelectorAll('.offcanvas img[alt="Logo"], .offcanvas-header img, .offcanvas .navbar-brand img');
                offcanvasLogos.forEach(function(img) {
                    img.src = logoSrc;
                });

                // Strategy 6: Target mobile-specific elements (d-lg-none = hidden on large screens)
                var mobileOnlyLogos = document.querySelectorAll('.d-lg-none img[alt="Logo"], .d-md-none img[alt="Logo"]');
                mobileOnlyLogos.forEach(function(img) {
                    img.src = logoSrc;
                });

                // Strategy 7: Target ANY navbar logo
                var navLogos = document.querySelectorAll('nav img[alt="Logo"], header img[alt="Logo"], .navbar img[alt="Logo"]');
                navLogos.forEach(function(img) {
                    img.src = logoSrc;
                });

                // Strategy 8: Update logo in top bar (if exists)
                var topBarLogos = document.querySelectorAll('.o_top_bar img[alt="Logo"], #top img[alt="Logo"]');
                topBarLogos.forEach(function(img) {
                    img.src = logoSrc;
                });
            }

            // Execution Strategy 1: Run immediately if DOM is ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', updateAllLogos);
            } else {
                updateAllLogos();
            }

            // Execution Strategy 2: Run on page show (handles browser cache)
            window.addEventListener('pageshow', updateAllLogos);

            // Execution Strategy 3: Run when Bootstrap offcanvas opens (mobile menu)
            document.addEventListener('shown.bs.offcanvas', function() {
                updateAllLogos();
            });

            // Execution Strategy 4: Run when Bootstrap collapse opens
            document.addEventListener('shown.bs.collapse', function() {
                updateAllLogos();
            });

            // Execution Strategy 5: Delayed execution as fallback (catches dynamically loaded content)
            setTimeout(updateAllLogos, 100);
            setTimeout(updateAllLogos, 500);
            setTimeout(updateAllLogos, 1000);

            // Execution Strategy 6: Watch for DOM changes (MutationObserver)
            // This catches logos that are added dynamically
            if (window.MutationObserver) {
                var observer = new MutationObserver(function(mutations) {
                    var shouldUpdate = false;
                    mutations.forEach(function(mutation) {
                        if (mutation.addedNodes.length &gt; 0) {
                            mutation.addedNodes.forEach(function(node) {
                                if (node.nodeType === 1) { // Element node
                                    // Check if added node contains logo
                                    if (node.tagName === 'IMG' &amp;&amp; node.alt === 'Logo') {
                                        shouldUpdate = true;
                                    }
                                    // Check if added node contains navbar
                                    if (node.querySelector &amp;&amp; node.querySelector('img[alt="Logo"]')) {
                                        shouldUpdate = true;
                                    }
                                }
                            });
                        }
                    });
                    if (shouldUpdate) {
                        updateAllLogos();
                    }
                });

                // Start observing the document for changes
                observer.observe(document.body, {
                    childList: true,
                    subtree: true
                });
            }
        })();
    </script>
    </xpath>

    </template>

    <template id="dynamic_footer_logo" inherit_id="website.template_footer_minimalist">

        <xpath expr="//a[hasclass('o_footer_logo')]" position="replace">
    <a href="/" class="o_footer_logo logo" id="footer_link">
        <!-- Single img element with responsive styling -->
        <img id="footer_logo" src="/flow_academy_website/static/src/image/4sight_logo.jpg" alt="Logo" data-mimetype="image/png" data-mimetype-before-conversion="image/png" data-resize-width="1920" data-quality="0" class="footer-logo-responsive" style="transform: scaleX(0.60) scaleY(0.60); animation-play-state: paused; transition: none; padding: 0px;"/>
    </a>

    <style>
        /* Responsive footer logo styling */
        .footer-logo-responsive {
            max-width: 100%;
            height: auto;
            display: block;
        }

        /* Desktop - keep current scale */
        @media (min-width: 769px) {
            .footer-logo-responsive {
                transform: scaleX(0.40) scaleY(0.40) !important;
            }
        }

        /* Tablet - reduce scale */
        @media (max-width: 768px) and (min-width: 577px) {
            .footer-logo-responsive {
                transform: scaleX(0.20) scaleY(0.20) !important;
                max-width: 50%;
                margin: 0 auto;
            }
        }

        /* Mobile - much smaller */
        @media (max-width: 576px) {
            .footer-logo-responsive {
                transform: scaleX(0.20) scaleY(0.20) !important;
                max-width: 40%;
                margin: 0 auto;
            }
        }

        /* Very small mobile devices - even smaller */
        @media (max-width: 375px) {
            .footer-logo-responsive {
                transform: scaleX(0.10) scaleY(0.10) !important;
                max-width: 30%;
                margin: 0 auto;
            }
        }

        /* Ensure footer logo link doesn't overflow */
        .o_footer_logo {
            display: inline-block;
            max-width: 100%;
            overflow: hidden;
        }
    </style>

    <script>
        (function() {
            // Function to get cookie value
            function getCookie(name) {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) return parts.pop().split(';').shift();
            }

            // Update footer logo
            function updateFooterLogo() {
                var logoElement = document.getElementById('footer_logo');
                var linkElement = document.getElementById('footer_link');
                if (!logoElement) return;

                var logoPreference = getCookie('logo_preference');

                if (logoPreference === 'flow_logo') {
                    logoElement.src = '/flow_academy_website/static/src/image/flow_logo.jpg';
                    linkElement.href = 'https://www.flowacademy.mt/';
                }
            }

            // Run on DOMContentLoaded
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', updateFooterLogo);
            } else {
                updateFooterLogo();
            }

            // Also run on page show (handles back/forward cache)
            window.addEventListener('pageshow', updateFooterLogo);
        })();
    </script>
    </xpath>
    </template>

