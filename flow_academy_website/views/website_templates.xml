                                <div class="slider-dots" id="dots"/>


                                <script>
                                    const track = document.getElementById("track");
                                    const items = document.querySelectorAll(".slider-item");
                                    const dotsContainer = document.getElementById("dots");

                                    const originalCount = items.length / 2; // solo logos reales
                                    const itemWidth = items[0].offsetWidth + 60;

                                    let index = 0;

                                    // Crear puntos
                                    for (let i = 0; i &lt; originalCount; i++) {
                                    const dot = document.createElement("span");
                                    if (i === 0) dot.classList.add("active");
                                    dot.addEventListener("click", () =&gt; moveToSlide(i));
                                    dotsContainer.appendChild(dot);
                                    }
                                    const dots = document.querySelectorAll(".slider-dots span");

                                    function updateDots() {
                                    dots.forEach(d =&gt; d.classList.remove("active"));
                                    dots[index % originalCount].classList.add("active");
                                    }

                                    function moveToSlide(i) {
                                    index = i;
                                    track.style.transition = "transform 0.5s ease";
                                    track.style.transform = `translateX(-${index * itemWidth}px)`;
                                    updateDots();
                                    }

                                    function moveNext() {
                                    index++;
                                    track.style.transition = "transform 0.5s ease";
                                    track.style.transform = `translateX(-${index * itemWidth}px)`;

                                    if (index === originalCount) {
                                    // Reset sin parpadeos
                                    setTimeout(() =&gt; {
                                    track.style.transition = "none";
                                    index = 0;
                                    track.style.transform = "translateX(0)";
                                    }, 500);
                                    }

                                    updateDots();
                                    }

                                    // Flechas
                                    document.querySelector(".arrow-right").addEventListener("click", moveNext);
                                    document.querySelector(".arrow-left").addEventListener("click", () =&gt; {
                                    index--;
                                    if (index &lt; 0) {
                                    track.style.transition = "none";
                                    index = originalCount - 1;
                                    track.style.transform = `translateX(-${index * itemWidth}px)`;
                                    setTimeout(() =&gt; track.style.transition = "transform 0.5s ease", 20);
                                    } else {
                                    track.style.transition = "transform 0.5s ease";
                                    track.style.transform = `translateX(-${index * itemWidth}px)`;
                                    }
                                    updateDots();
                                    });

                                    // Auto-slide
                                    setInterval(moveNext, 3000);

                                    // Swipe móvil
                                    let startX = 0;
                                    track.addEventListener("touchstart", e =&gt; startX = e.touches[0].clientX);
                                    track.addEventListener("touchend", e =&gt; {
                                    let endX = e.changedTouches[0].clientX;
                                    if (endX &lt; startX - 50) moveNext();
                                    if (endX &gt; startX + 50) document.querySelector(".arrow-left").click();
                                    });
                                </script>
