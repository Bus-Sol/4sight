                /* ========================================
                   RESPONSIVE EVENT SLIDER STYLES
                   ======================================== */

                /* 1. Main Wrapper - Responsive Padding */
                .position-relative {
                    padding: 0 50px;
                }

                @media (max-width: 768px) {
                    .position-relative {
                        padding: 0 15px;
                    }
                }

                @media (max-width: 576px) {
                    .position-relative {
                        padding: 0 2px;
                    }
                }

                /* 2. Slider Control */
                .event-slider-wrapper {
                    display: flex;
                    overflow-x: auto;
                    overflow-y: hidden;
                    scroll-behavior: smooth;
                    -webkit-overflow-scrolling: touch;
                    padding-bottom: 15px;
                    scrollbar-width: none;
                    -ms-overflow-style: none;
                     scroll-snap-type: x mandatory;
                    -webkit-scroll-snap-type: x mandatory;
                }

                .event-slider-wrapper::-webkit-scrollbar {
                    display: none;
                }

                /* Event cards container - replaces row */
                .event-cards-container {
                    display: flex;
                    flex-wrap: nowrap;
                    gap: 20px; /* Add gap between cards */
                    padding: 0;
                    margin: 0;
                    width: max-content; /* Allow natural width */
                }

                /* Critical: Override any global CSS that might interfere */
                .course-events .event-slider-wrapper {
                    display: flex !important;
                    overflow-x: auto !important;
                }

                .course-events .event-cards-container {
                    display: flex !important;
                    flex-wrap: nowrap !important;
                }

                .course-events .event-card-item {
                    flex-shrink: 0 !important;
                }

                /* 3. Navigation Buttons - Responsive Sizing */
                .slider-nav-btn {
                    position: absolute;
                    top: 50%;
                    transform: translateY(-50%);
                    z-index: 10;
                    width: 45px;
                    height: 45px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
