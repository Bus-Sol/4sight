<odoo>
    <template id="events_by_category" name="Events by Type">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row">
                    <t t-if="events">
                        <t t-foreach="events" t-as="event">
                            <div class="col-md-6 col-lg-4 mb-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title" t-field="event.name"/>

                                        <p class="card-text text-muted">
                                            <i class="fa fa-calendar me-2"/>
                                            <span t-field="event.date_begin" t-options='{"format": "d MMMM y"}'/>
                                            -
                                            <span t-field="event.date_end" t-options='{"format": "d MMMM y"}'/>
                                        </p>

                                        <p class="card-text small">
                                            <i class="fa fa-clock-o me-2"/>
                                            <span t-field="event.date_begin" t-options='{"format": "short"}'/>
                                        </p>
                                        <p class="card-text text-muted">
                                            <i class="fa fa-ticket me-2"/>
                                            Available Seats: <span t-field="event.seats_available"/>
                                        </p>
                                    </div>

                                    <div class="card-footer bg-white border-top-0">
                                        <button t-if="event.event_registrations_open" type="button" data-bs-toggle="modal" data-bs-target="#modal_ticket_registration" class="btn btn-primary w-100">Register</button>
        <div t-if="registration_error_code == 'insufficient_seats'" class="alert alert-danger my-3" role="alert">
            Registration failed! These tickets are not available anymore.
        </div>
                                        <p t-if="not event.event_registrations_open">
                                            NOT AVAILABLE
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>

                    <t t-else="">
                        <div class="col-12 text-center alert alert-info">
                            No upcoming events found for this type.
                        </div>
                    </t>
                </div>
            </div>
                    <t t-call="website_event.modal_ticket_registration"/>
        </t>
    </template>


    <template id="modal_ticket_registration" inherit_id="website_event.modal_ticket_registration">


         <xpath expr="//div[hasclass('o_wevent_registration_title')]" position="after">
            <div class="o_wevent_registration_title modal-title fs-5" id="staticLabel">Seats</div>
        </xpath>

         <xpath expr="//div[@id='staticBackdropLabel']" position="replace">
        </xpath>


    </template>

    <template id="registration_attendee_details" inherit_id="website_event.registration_attendee_details">


         <xpath expr="//div[hasclass('modal-body')]/h5" position="after">
            <h5 t-attf-class="mt-1 pb-2 #{'border-bottom' if event.question_ids else ''}">Seat #<span t-out="counter"/> <small class="text-muted">- <span t-out="ticket['name']"/></small></h5>
        </xpath>

         <xpath expr="//div[hasclass('modal-body')]/h5[1]" position="replace">
        </xpath>


    </template>


    <template id="event_confirmation" inherit_id="website_event_sale.event_confirmation">
        <xpath expr="//t[@t-if='events']" position="replace">
        </xpath>

    </template>

    <template id="sale_address" inherit_id="website_sale.address">
        <xpath expr="//form/div[1]//div[contains(@t-attf-class, 'div_name')]" position="before">
            <div t-attf-class="#{error.get('company_type') and 'o_has_error'} div_company_type col-lg-6 mb-2">
                <label class="col-form-label" for="company_type">Contact Type</label>
                <select id="company_type" name="company_type" t-attf-class="form-select #{error.get('company_type') and 'is-invalid' or ''}" t-att-mode="mode[1]">
                    <option value="person">Individual</option>
                    <option value="company">Company</option>
                </select>
            </div>
        </xpath>

        <xpath expr="//form/div[1]//div[contains(@t-attf-class, 'div_name')]" position="replace">
            <div t-attf-class="o_company_field div_name col-lg-12 mb-2 #{error.get('name') and 'o_has_error'}">
            <label class="col-form-label" for="name">
                <span t-if="company_type == 'company'">Company Name</span>
                <span t-else="">Full name</span>
            </label>
            <input type="text" name="name" t-attf-class="form-control #{error.get('name') and 'is-invalid' or ''}" t-att-value="'name' in checkout and checkout['name']"/>
        </div>

        <div class="w-100"/>
        <div t-attf-class="o_individual_field col-lg-6 mb-2 #{error.get('firstname') and 'o_has_error'}" t-att-style="company_type == 'company' and 'display: none;' or None">
            <label class="col-form-label" for="firstname">First Name</label>
            <input type="text" name="firstname" t-attf-class="form-control #{error.get('firstname') and 'is-invalid' or ''}" t-att-value="'firstname' in checkout and checkout['firstname']"/>
        </div>
        <div t-attf-class="o_individual_field col-lg-6 mb-2 #{error.get('lastname') and 'o_has_error'}" t-att-style="company_type == 'company' and 'display: none;' or None">
            <label class="col-form-label" for="lastname">Surname</label>
            <input type="text" name="lastname" t-attf-class="form-control #{error.get('lastname') and 'is-invalid' or ''}" t-att-value="'lastname' in checkout and checkout['lastname']"/>
        </div>
        </xpath>

        <xpath expr="//form/div[1]//div[contains(@t-attf-class, 'div_vat')]" position="attributes">
            <attribute name="t-attf-class">#{error.get('vat') and 'o_has_error'} o_company_field div_vat col-lg-6 mb-2</attribute>
        </xpath>

    </template>


</odoo>