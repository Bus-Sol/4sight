<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Form View to Modify it -->
        <record id="mailing_list_view_form_inherit" model="ir.ui.view">
            <field name="name">mailing.list.form</field>
            <field name="model">mailing.list</field>
            <field name="inherit_id" ref="mass_mailing.mailing_list_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='is_public']" position="after">
                    <field name="is_flow"/>

                </xpath>

            </field>
        </record>


    </data>
</odoo>