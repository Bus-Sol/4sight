<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_team_view_form_flow_template" model="ir.ui.view">
        <field name="name">crm.team.form.flow.template</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='left']" position="inside">
                <field
                    name="sale_order_template_id"
                    groups="sale_management.group_sale_order_template"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
